{
  "cardsV2": [
    {
      "cardId": "ios-report",
      "card": {
        "header": {
          "title": "${STATUS_ICON} [iOS] Automation Report",
          "subtitle": "${DATE_TIME}"
        },
        "sections": [
          {
            "widgets": [
              {
                "buttonList": {
                  "buttons": [
                    {
                      "text": "📄 VIEW ALLURE REPORT",
                      "onClick": {
                        "openLink": {
                          "url": "${REPORT_URL}"
                        }
                      }
                    },
                    {
                      "text": "📊 VIEW TEST RESULTS",
                      "onClick": {
                        "openLink": {
                          "url": "${GSHEET_URL}"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "textParagraph": {
                  "text": "<b>Summary</b>"
                }
              },
              {
                "textParagraph": {
                  "text": "📦 <b>Total:</b> ${TOTAL}<br>✅ <b>Passed:</b> ${PASSED} (${PASS_RATE}%)<br>❌ <b>Failed:</b> ${FAILED}<br>⏭️ <b>Skipped:</b> ${SKIPPED}<br>⏱️ <b>Duration:</b> ${DURATION}<br>🌿 <b>Branch auto:</b> <code>${BRANCH_AUTO}</code><br>🌿 <b>Branch code:</b> <code>${BRANCH_CODE}</code><br>📱 <b>Device:</b> ${DEVICE}<br>📝 <b>Note:</b> ${NOTE}<br><b>Status:</b> <font color=\"${STATUS_COLOR}\"><b>${STATUS}</b></font>"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
