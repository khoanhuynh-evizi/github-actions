{
  "cardsV2": [
    {
      "cardId": "wdio-report",
      "card": {
        "header": {
          "title": "${STATUS_ICON} [Dashboard] ${REPORT_TYPE} - ${SUITE_TYPE} Test Report",
          "subtitle": "${SUITE_LABEL} · ${DATE_TIME}"
        },
        "sections": [
          {
            "widgets": [
              {
                "textParagraph": {
                  "text": "🌐 <b>Env:</b> ${ENV_URL}<br>🎫 <b>Tickets:</b> ${TICKETS}"
                }
              },
              {
                "buttonList": {
                  "buttons": [
                    {
                      "text": "📄 VIEW ALLURE REPORT",
                      "onClick": {
                        "openLink": {
                          "url": "${REPORT_URL}"
                        }
                      }
                    },
                    {
                      "text": "📊 VIEW TEST RESULTS",
                      "onClick": {
                        "openLink": {
                          "url": "${GSHEET_URL}"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "textParagraph": {
                  "text": "<b>Test Summary</b>"
                }
              },
              {
                "textParagraph": {
                  "text": "<b>Spec Files</b><br>📁 <b>Total:</b> ${TOTAL}<br>✅ <b>Passed:</b> ${PASSED} (${PASS_RATE}%)<br>❌ <b>Failed:</b> ${FAILED}<br>⏭️ <b>Skipped:</b> ${SKIPPED}<br>🔁 <b>Retries:</b> ${RETRIES}"
                }
              },
              {
                "textParagraph": {
                  "text": "<b>Test Cases (Allure)</b><br>🧪 <b>Total:</b> ${TC_TOTAL}<br>✅ <b>Passed:</b> ${TC_PASSED} (${TC_PASS_RATE}%)<br>❌ <b>Failed:</b> ${TC_FAILED}<br>⏭️ <b>Skipped:</b> ${TC_SKIPPED}"
                }
              },
              {
                "textParagraph": {
                  "text": "⏱️ <b>Duration:</b> ${DURATION}<br>🌿 <b>Branch auto:</b> <code>${BRANCH_WDIO}</code><br>🌿 <b>Branch code:</b> <code>${BRANCH_DASHBOARD}</code><br><b>Status:</b> <font color=\"${STATUS_COLOR}\"><b>${STATUS}</b></font>"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
